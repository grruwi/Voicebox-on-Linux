+#pragma once
+
+// Voicebox: cache próbki głosu NA DYSKU. Zmiana profilu to dwa ciężkie kroki:
+// AudioVAE koduje próbkę na cechy (~1,6 s na 29 s próbki) i LocEnc robi z cech
+// embeddingi dla BaseLM (~0,8 s). Oba wyniki to kilka MB floatów, a cache w RAM
+// trzyma domyślnie jeden profil i znika z procesem — stąd pliki.
+//
+// Klucz = treść (próbki, transkrypt, cechy) + typ wag, który liczył wynik.
+// Katalog podaje wołający (`voxcpm2.prompt_disk_cache_dir`) i to on odpowiada
+// za rozdzielenie różnych modeli. Każdy błąd dysku = zwykły brak w cache,
+// nigdy błąd generacji.
+
+#include "engine/framework/runtime/session.h"
+
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <optional>
+#include <string>
+#include <system_error>
+#include <thread>
+#include <vector>
+
+namespace engine::models::voxcpm2::prompt_disk_cache {
+
+// Dwa FNV-1a 64 z różnymi ziarnami i mnożnikami = 128 bitów nazwy pliku.
+class Hasher {
+public:
+  void bytes(const void *data, size_t size) {
+    const auto *p = static_cast<const unsigned char *>(data);
+    for (size_t i = 0; i < size; ++i) {
+      a_ = (a_ ^ p[i]) * 0x100000001B3ULL;
+      b_ = (b_ ^ p[i]) * 0x9E3779B97F4A7C15ULL;
+    }
+  }
+  void i64(int64_t value) { bytes(&value, sizeof(value)); }
+  void str(const std::string &value) {
+    i64(static_cast<int64_t>(value.size()));
+    bytes(value.data(), value.size());
+  }
+  void floats(const std::vector<float> &values) {
+    i64(static_cast<int64_t>(values.size()));
+    bytes(values.data(), values.size() * sizeof(float));
+  }
+  void audio(const std::optional<runtime::AudioBuffer> &value) {
+    if (!value.has_value()) {
+      i64(-1);
+      return;
+    }
+    i64(value->sample_rate);
+    i64(value->channels);
+    floats(value->samples);
+  }
+  std::string hex() const {
+    static constexpr char kDigits[] = "0123456789abcdef";
+    std::string out;
+    for (const uint64_t word : {a_, b_}) {
+      for (int shift = 60; shift >= 0; shift -= 4) {
+        out.push_back(kDigits[(word >> shift) & 0xF]);
+      }
+    }
+    return out;
+  }
+
+private:
+  uint64_t a_ = 0xCBF29CE484222325ULL;
+  uint64_t b_ = 0x84222325CBF29CE4ULL;
+};
+
+struct Blob {
+  std::vector<int64_t> ints;
+  std::vector<std::vector<float>> arrays;
+};
+
+inline constexpr char kMagic[8] = {'V', 'B', 'X', 'C', 'A', 'C', 'H', '1'};
+
+// Zapis przez plik tymczasowy + rename: czytelnik nigdy nie trafi na połówkę.
+inline bool save(const std::filesystem::path &file, const Blob &blob) {
+  std::error_code ec;
+  std::filesystem::create_directories(file.parent_path(), ec);
+  const auto tmp = file.string() + ".tmp" +
+                   std::to_string(std::hash<std::thread::id>{}(
+                       std::this_thread::get_id()));
+  {
+    std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+    if (!out) {
+      return false;
+    }
+    auto put_i64 = [&](int64_t v) {
+      out.write(reinterpret_cast<const char *>(&v), sizeof(v));
+    };
+    out.write(kMagic, sizeof(kMagic));
+    put_i64(static_cast<int64_t>(blob.ints.size()));
+    put_i64(static_cast<int64_t>(blob.arrays.size()));
+    for (const int64_t v : blob.ints) {
+      put_i64(v);
+    }
+    for (const auto &array : blob.arrays) {
+      put_i64(static_cast<int64_t>(array.size()));
+      out.write(reinterpret_cast<const char *>(array.data()),
+                static_cast<std::streamsize>(array.size() * sizeof(float)));
+    }
+    if (!out) {
+      out.close();
+      std::filesystem::remove(tmp, ec);
+      return false;
+    }
+  }
+  std::filesystem::rename(tmp, file, ec);
+  if (ec) {
+    std::filesystem::remove(tmp, ec);
+    return false;
+  }
+  return true;
+}
+
+inline std::optional<Blob> load(const std::filesystem::path &file,
+                                size_t expected_ints, size_t expected_arrays) {
+  std::ifstream in(file, std::ios::binary);
+  if (!in) {
+    return std::nullopt;
+  }
+  char magic[sizeof(kMagic)] = {};
+  in.read(magic, sizeof(magic));
+  if (!in || std::memcmp(magic, kMagic, sizeof(kMagic)) != 0) {
+    return std::nullopt;
+  }
+  auto get_i64 = [&](int64_t &v) {
+    in.read(reinterpret_cast<char *>(&v), sizeof(v));
+    return static_cast<bool>(in);
+  };
+  int64_t n_ints = 0;
+  int64_t n_arrays = 0;
+  if (!get_i64(n_ints) || !get_i64(n_arrays) ||
+      n_ints != static_cast<int64_t>(expected_ints) ||
+      n_arrays != static_cast<int64_t>(expected_arrays)) {
+    return std::nullopt;
+  }
+  Blob blob;
+  blob.ints.resize(expected_ints);
+  for (auto &v : blob.ints) {
+    if (!get_i64(v)) {
+      return std::nullopt;
+    }
+  }
+  blob.arrays.resize(expected_arrays);
+  for (auto &array : blob.arrays) {
+    int64_t count = 0;
+    if (!get_i64(count) || count < 0 || count > (int64_t{1} << 31)) {
+      return std::nullopt;
+    }
+    array.resize(static_cast<size_t>(count));
+    in.read(reinterpret_cast<char *>(array.data()),
+            static_cast<std::streamsize>(array.size() * sizeof(float)));
+    if (!in) {
+      return std::nullopt;
+    }
+  }
+  return blob;
+}
