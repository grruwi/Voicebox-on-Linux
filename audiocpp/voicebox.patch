+                ggml_tensor * dst = kv == 0 ? layers_[layer].key_tensor.tensor
+                                            : layers_[layer].value_tensor.tensor;
+                if (src == nullptr || src->data == nullptr || src->buffer == nullptr ||
+                    !ggml_is_contiguous(src) || ggml_nelements(src) < count) {
