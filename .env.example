# Copy to .env. Everything optional — empty = transcript refine is off, the rest works.
# An OpenAI-compatible LLM server as seen FROM INSIDE the container (not localhost —
# that is the container itself):
LMSTUDIO_BASE_URL=
LMSTUDIO_API_KEY=

# Optional layers for good (instead of -f on every command), e.g.:
# COMPOSE_FILE=docker-compose.yml:docker-compose.rocm.yml:docker-compose.pytorch.yml
